# HTML никогда не кэшируется: иначе после деплоя игроки остаются на старой сборке.
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Хешированные ассеты неизменяемы — их можно кэшировать навсегда.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
