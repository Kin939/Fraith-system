{
  "name": "fraith-system",
  "private": true,
  "version": "1.0.0",
  "description": "D&D 5e Campaign Portal (3 Players + 1 DM) on Cloudflare Pages, Workers, D1, R2 & Durable Objects with Long Story Short integration",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8788",
    "dev:vite": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && vite build",
    "db:migrate:local": "wrangler d1 migrations apply fraith-dnd-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fraith-dnd-db --remote",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@longstoryshort/vtt-sdk": "^0.9.0",
    "bcryptjs": "^2.4.3",
    "hono": "^4.7.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tldraw": "^3.15.6",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wrangler": "^4.168.0"
  }
}
