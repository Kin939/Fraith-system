{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true
  },
  "include": [
    "functions/**/*.ts",
    "workers/**/*.ts",
    "src/lib/db.ts",
    "src/lib/r2.ts",
    "src/lib/auth.ts",
    "src/lib/bootstrap.ts",
    "src/lib/combatProtocol.ts",
    "src/lib/literatureDb.ts"
  ]
}
